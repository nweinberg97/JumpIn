# ─────────────────────────────────────────────────────────────────────────────
# JumpIn environment configuration
#
# Every variable here is OPTIONAL. With none of them set, JumpIn runs in demo
# mode: a demo sign-in, seeded members, demo calendar availability and a
# Google Meet handoff to meet.google.com/new. Each integration switches to the
# real provider as soon as its variables are present.
#
# Copy to .env.local and fill in what you have. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this app. Used to build OAuth redirect URIs and invite links.
APP_URL=http://localhost:3000

# 32+ random bytes used to sign session cookies and invite links, and to
# encrypt provider tokens at rest in cookies. Required for any real
# integration. Generate with:  openssl rand -base64 32
SESSION_SECRET=

# ── LinkedIn: "Sign In with LinkedIn using OpenID Connect" ──────────────────
# developer.linkedin.com → Create app → Products → add
# "Sign In with LinkedIn using OpenID Connect" (scopes: openid profile email).
# Authorized redirect URL:  {APP_URL}/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Google: sign-in + Calendar free/busy + Meet creation ────────────────────
# console.cloud.google.com → APIs & Services
#   1. Enable "Google Calendar API"
#   2. OAuth consent screen: add scopes openid, email, profile,
#      .../auth/calendar.events and .../auth/calendar.freebusy;
#      add yourself as a test user while the app is in "Testing"
#   3. Credentials → OAuth client ID → Web application
# Authorized redirect URI:  {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Instagram (optional social identity) ─────────────────────────────────────
# Uses "Instagram API with Instagram Login" (the Basic Display API was retired
# in December 2024). Only Instagram Business/Creator accounts can authorize.
# developers.facebook.com → Create app → add Instagram product →
# "API setup with Instagram login". Scope: instagram_business_basic
# Redirect URI:  {APP_URL}/api/auth/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Invite emails (the "Are you still free to connect?" email) ──────────────
# Sent from a JumpIn address so nobody's personal email is exposed.
# resend.com → API key, and a verified sending domain.
RESEND_API_KEY=
INVITE_FROM_EMAIL="JumpIn <hello@yourdomain.com>"
# Seeded members have undeliverable example addresses. Set this to your own
# email to receive every invite (and scheduled-call guest invite) yourself,
# so you can try the recipient's side of the flow end to end.
INVITE_TEST_RECIPIENT=

# ── Future backend (not used by the prototype) ───────────────────────────────
# See README → "Adding a real backend". The local repository in
# src/lib/data/localRepository.ts is the only thing that needs replacing.
# DATABASE_URL=
